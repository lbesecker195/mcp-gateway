# Copy to /etc/mcp-gateway.env on the host. deploy.sh creates it on first run with
# generated secrets; these are the knobs you may want to edit afterwards.

# --- required, generated on first deploy ---
SECRET_KEY_BASE=
DATABASE_URL=ecto://mcp_gateway:CHANGEME@127.0.0.1/mcp_gateway_prod

# --- where the gateway lives ---
PHX_HOST=gateway.mcpharbor.dev
PORT=4620
CANONICAL_BASE_URL=https://gateway.mcpharbor.dev
PHX_SERVER=true

# --- upstream contact details (REQUIRED by those providers' terms) ---
# SEC and NWS both require a User-Agent identifying the operator with real contact info.
# Crossref and NCBI want a contact email. These are not optional niceties: calling those
# APIs without them breaches the terms we recorded in catalog/COMPLIANCE.md, and the
# affected catalog entries fail closed until these are set.
GATEWAY_CONTACT_UA=
GATEWAY_CONTACT_EMAIL=

# --- optional upstream keys: raise quotas, entries fail closed without them ---
NASA_API_KEY=
NCBI_API_KEY=
BLS_API_KEY=
OPENALEX_API_KEY=

# --- tuning ---
# Each live upstream holds a Node/Python subprocess until it goes idle. Lower this to trade
# cold-start latency for memory on a shared box.
UPSTREAM_IDLE_TIMEOUT_MS=180000
