# Copy to deploy/deploy.env (gitignored) and fill in for your host.
#
#     cp deploy/deploy.env.example deploy/deploy.env
#
# Kept out of the repository so the server's address and the other sites it hosts are not
# published. CI passes these as secrets instead (see deploy/README.md).

# SSH target: a Host alias from ~/.ssh/config, or user@host.
DEPLOY_HOST=

# Public domain this gateway answers on.
DEPLOY_DOMAIN=gateway.mcpharbor.dev

# Loopback port the release binds; nginx proxies to it. Pick one nothing else uses.
DEPLOY_PORT=4620
